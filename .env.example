# Designer Homes — Book store environment variables (TEMPLATE — safe to commit)
# Copy to .env (which is gitignored), fill in the REPLACE_ME values, then run
# scripts/set-vercel-env.sh to push them to Vercel. Never commit real secrets.

# --- Stripe (use TEST keys while developing) ---
STRIPE_SECRET_KEY=REPLACE_ME              # sk_test_... (later sk_live_...)
STRIPE_WEBHOOK_SECRET=REPLACE_ME          # whsec_... from the BOOK webhook endpoint
# STRIPE_AUTOMATIC_TAX=true               # optional; only after you configure Stripe Tax

# --- Supabase ---
SUPABASE_URL=REPLACE_ME                    # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_ME            # service_role key (server only)

# --- Email (Resend) ---
RESEND_API_KEY=REPLACE_ME                  # re_...
BOOK_FROM_EMAIL="Designer Homes Real Estate <info@designerhomesre.com>"
BOOK_ADMIN_EMAIL=info@designerhomesre.com

# --- App ---
SITE_URL=https://designerhomesre.com

# --- Secrets (already generated for you; keep private) ---
ADMIN_API_TOKEN=REPLACE_ME                 # random 64-hex; protects the order dashboard
DOWNLOAD_SIGNING_SECRET=REPLACE_ME         # random 64-hex; signs download links
